      "id": "a1111111-0000-4000-8000-000000000003",
      "name": "Buscar Metas - Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [220, 120],
      "credentials": {
