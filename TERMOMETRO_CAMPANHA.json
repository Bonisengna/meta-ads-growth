      "id": "a1111111-0000-4000-8000-000000000004",
      "name": "Juntar Notion + Sheets (bruto)",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [460, 0]
    },
    {
      "parameters": {
        "jsCode": "// O QUE FAZ: junta os dados do Notion (cadastro do cliente) com os da\n// planilha do Google Sheets (metas de CPL e orçamento), usando o\n// ad_account_id como chave de cruzamento.\n//\n// POR QUE: o Notion é o cadastro mestre do cliente, mas a meta de CPL\n// muda com frequência e o Sheets é mais rápido de editar (até pelo\n// celular). Se a mesma conta existir nas duas fontes, o valor do\n// Sheets tem prioridade, porque é o mais \"vivo\" / atualizado.\n\nconst itensNotion = $input.all().filter(item => item.json.ad_account_id_notion || item.json.properties);\nconst todos = $input.all();\n\n// Separa por origem usando o node de origem (merge combineByPosition\n// entrega os itens intercalados, então recuperamos pelo pairedItem)\nconst doNotion = [];\nconst doSheets = [];\n\nfor (const item of todos) {\n  const fonte = item.json.__fonte || (item.json.ad_account_id ? 'sheets' : 'notion');\n  if (item.json.properties) {\n    doNotion.push(item.json);\n  } else {\n    doSheets.push(item.json);\n  }\n}\n\n// Monta um mapa de metas por conta a partir do Sheets\nconst metasPorConta = {};\nfor (const linha of doSheets) {\n  if (linha.ad_account_id) {\n    metasPorConta[linha.ad_account_id] = {\n      cpl_meta: parseFloat(linha.cpl_meta),\n      orcamento_diario: parseFloat(linha.orcamento_diario)\n    };\n  }\n}\n\nconst resultado = [];\n\nfor (const pagina of doNotion) {\n  const props = pagina.properties || {};\n\n  const nomeCliente = props['Nome cliente']?.title?.[0]?.plain_text || 'Sem nome';\n  const adAccountId = props['Ad Account ID']?.rich_text?.[0]?.plain_text || null;\n  const eventoConversao = props['Evento de conversão']?.select?.name || 'lead';\n\n  if (!adAccountId) continue; // sem ID de conta não dá pra consultar o Meta\n\n  // Prioriza meta do Sheets; se não achar, cai pro valor do Notion (se existir)\n  const metaSheets = metasPorConta[adAccountId];\n  const cplMetaNotion = props['CPL Meta']?.number || null;\n  const orcamentoNotion = props['Orçamento diário']?.number || null;\n\n  resultado.push({\n    json: {\n      nome_cliente: nomeCliente,\n      ad_account_id: adAccountId,\n      evento_conversao: eventoConversao,\n      cpl_meta: metaSheets ? metaSheets.cpl_meta : cplMetaNotion,\n      orcamento_diario: metaSheets ? metaSheets.orcamento_diario : orcamentoNotion,\n      origem_meta: metaSheets ? 'google_sheets' : 'notion'\n    }\n  });\n}\n\nreturn resultado;"
      },
      "id": "a1111111-0000-4000-8000-000000000005",
      "name": "Combinar Fontes (Notion + Sheets)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 0]
    },
