    {
      "parameters": {
        "method": "GET",
        "url": "=https://graph.facebook.com/v21.0/act_{{ $json.ad_account_id }}/insights",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "fields",
              "value": "campaign_name,spend,cpm,cpc,ctr,actions,cost_per_action_type"
            },
            {
              "name": "date_preset",
              "value": "today"
            },
            {
              "name": "level",
              "value": "campaign"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $credentials.metaMarketingApi.token }}"
            }
          ]
        },
        "options": {}
      },
      "id": "a1111111-0000-4000-8000-000000000007",
      "name": "Buscar Métricas - Meta Ads",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 0],
      "credentials": {
        "httpHeaderAuth": {
          "id": "CREDENCIAL_META_TOKEN",
          "name": "Meta Marketing API - System User"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// O QUE FAZ: pega a resposta bruta do Meta Ads (spend, ações, custo por\n// tipo de ação) e calcula o CPL real de cada campanha do cliente.\n//\n// POR QUE: o Meta não devolve \"CPL\" pronto — ele devolve um array de\n// cost_per_action_type com vários tipos de conversão junto. Aqui a\n// gente filtra só o evento que representa lead pra esse cliente\n// (definido lá no cadastro, campo evento_conversao) e calcula manual.\n\nconst dadosCliente = $('Dividir por Cliente').item.json;\nconst respostaMeta = $input.item.json.data || [];\n\nconst campanhasProcessadas = [];\n\nfor (const campanha of respostaMeta) {\n  const gasto = parseFloat(campanha.spend || 0);\n  const ctr = parseFloat(campanha.ctr || 0);\n  const cpm = parseFloat(campanha.cpm || 0);\n\n  // Procura, dentro de cost_per_action_type, o evento de conversão\n  // configurado pra esse cliente (ex: 'lead', 'onsite_conversion.lead_grouped')\n  const custoPorAcao = campanha.cost_per_action_type || [];\n  const acaoLead = custoPorAcao.find(a => a.action_type === dadosCliente.evento_conversao);\n\n  const cplReal = acaoLead ? parseFloat(acaoLead.value) : null;\n\n  campanhasProcessadas.push({\n    json: {\n      nome_cliente: dadosCliente.nome_cliente,\n      ad_account_id: dadosCliente.ad_account_id,\n      cpl_meta: dadosCliente.cpl_meta,\n      orcamento_diario: dadosCliente.orcamento_diario,\n      campanha: campanha.campaign_name,\n      gasto_hoje: gasto,\n      ctr: ctr,\n      cpm: cpm,\n      cpl_real: cplReal\n    }\n  });\n}\n\nreturn campanhasProcessadas;"
      },
      "id": "a1111111-0000-4000-8000-000000000008",
      "name": "Calcular CPL Real",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1340, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "cond1",
              "leftValue": "={{ $json.cpl_real }}",
              "rightValue": "={{ $json.cpl_meta * 1.3 }}",
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1111111-0000-4000-8000-000000000009",
      "name": "CPL Estourou a Meta?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1560, 0]
