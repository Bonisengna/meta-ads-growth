    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"llama-3.3-70b-versatile\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"Você é um analista de tráfego pago. Responda em português, curto e direto, sem enrolação.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Campanha {{ $json.campanha }} do cliente {{ $json.nome_cliente }}. CPL meta: R$ {{ $json.cpl_meta }}. CPL real hoje: R$ {{ $json.cpl_real }}. Gasto até agora: R$ {{ $json.gasto_hoje }}. CTR: {{ $json.ctr }}%. CPM: R$ {{ $json.cpm }}. Dê 1 causa provável do estouro e 1 ação recomendada, em até 3 linhas.\"\n    }\n  ],\n  \"max_tokens\": 200\n}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $credentials.groqApi.token }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {}
      },
      "id": "a1111111-0000-4000-8000-000000000010",
      "name": "Gerar Diagnóstico - Groq",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1780, -120],
      "credentials": {
        "httpHeaderAuth": {
          "id": "CREDENCIAL_GROQ",
          "name": "Groq API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// O QUE FAZ: monta o texto final da mensagem de WhatsApp, juntando os\n// números da campanha com o diagnóstico que o Groq gerou.\n//\n// POR QUE: separar \"montar mensagem\" de \"enviar mensagem\" em dois nodes\n// deixa mais fácil trocar o canal de envio no futuro (ex: e-mail,\n// Telegram) sem mexer na lógica de formatação.\n\nconst dados = $('Calcular CPL Real').item.json;\nconst diagnostico = $input.item.json.choices?.[0]?.message?.content || 'Diagnóstico indisponível.';\n\nconst percentualEstouro = (((dados.cpl_real - dados.cpl_meta) / dados.cpl_meta) * 100).toFixed(0);\n\nconst mensagem = `🔴 Alerta de CPL - ${dados.nome_cliente}\nCampanha: ${dados.campanha}\n\nCPL atual: R$ ${dados.cpl_real.toFixed(2)} (meta R$ ${dados.cpl_meta.toFixed(2)}, +${percentualEstouro}%)\nGasto hoje: R$ ${dados.gasto_hoje.toFixed(2)}\nCTR: ${dados.ctr}%\n\nDiagnóstico:\n${diagnostico}`;\n\nreturn [{\n  json: {\n    ...dados,\n    diagnostico,\n    mensagem_whatsapp: mensagem\n  }\n}];"
      },
