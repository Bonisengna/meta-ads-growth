    {
      "parameters": {
        "jsCode": "const data = items[0].json.data || [];\n\nfunction getActionValue(actions, actionType) {\n  if (!Array.isArray(actions)) return 0;\n\n  const found = actions.find(action => action.action_type === actionType);\n\n  return found ? Number(found.value) || 0 : 0;\n}\n\nfunction traduzirObjetivo(objective) {\n  const mapa = {\n    \"CONVERSIONS\": \"Conversões\",\n    \"OUTCOME_ENGAGEMENT\": \"Engajamento\",\n    \"OUTCOME_LEADS\": \"Leads\",\n    \"OUTCOME_TRAFFIC\": \"Tráfego\",\n    \"OUTCOME_AWARENESS\": \"Reconhecimento\",\n    \"OUTCOME_SALES\": \"Vendas\",\n    \"MESSAGES\": \"Mensagens\",\n    \"LINK_CLICKS\": \"Cliques no link\",\n    \"LEAD_GENERATION\": \"Geração de cadastros\",\n    \"POST_ENGAGEMENT\": \"Engajamento com publicação\"\n  };\n\n  return mapa[objective] || objective || \"\";\n}\n\nreturn data.map(campanha => {\n  const investimento = Number(campanha.spend || 0);\n  const impressoes = Number(campanha.impressions || 0);\n  const alcance = Number(campanha.reach || 0);\n  const cliques = Number(campanha.clicks || 0);\n\n  const cliquesLink = getActionValue(\n    campanha.actions,\n    'link_click'\n  );\n\n  const conversasIniciadas = getActionValue(\n    campanha.actions,\n    'onsite_conversion.messaging_conversation_started_7d'\n  );\n\n  const primeirasRespostas = getActionValue(\n    campanha.actions,\n    'onsite_conversion.messaging_first_reply'\n  );\n\n  const conexoesMensagem = getActionValue(\n    campanha.actions,\n    'onsite_conversion.total_messaging_connection'\n  );\n\n  const visualizacoesVideo = getActionValue(\n    campanha.actions,\n    'video_view'\n  );\n\n  // Para campanhas de WhatsApp/Messenger, estamos tratando LEADS como conversas iniciadas.\n  const leads = conversasIniciadas;\n\n  const cpl = leads > 0\n    ? investimento / leads\n    : null;\n\n  const custoPorConversa = conversasIniciadas > 0\n    ? investimento / conversasIniciadas\n    : null;\n\n  return {\n    json: {\n      \"CONTA ANUNCIO\": campanha.account_id || \"742175035567342\",\n\n      \"DATA INCIO\": campanha.date_start || \"\",\n      \"DATA FIM\": campanha.date_stop || \"\",\n\n      \"NIVEL ANALISE\": \"Campanha\",\n\n      \"ID CAMPANHA\": campanha.campaign_id || \"\",\n      \"NOME CAMPANHA\": campanha.campaign_name || \"\",\n\n      \"OBJETIVO\": traduzirObjetivo(campanha.objective),\n      \"OBJETIVO ORIGINAL\": campanha.objective || \"\",\n\n      \"CONJUNTO\": \"Nível Campanha\",\n      \"ANUNCIO\": \"Nível Campanha\",\n\n      \"INVESTIMENTO\": Number(investimento.toFixed(2)),\n      \"IMPRESSOES\": impressoes,\n      \"ALCANCE\": alcance,\n      \"CLIQUES\": cliques,\n\n      \"LEADS\": leads,\n\n      \"CPC\": campanha.cpc\n        ? Number(Number(campanha.cpc).toFixed(2))\n        : 0,\n\n      \"CTR\": campanha.ctr\n        ? Number(Number(campanha.ctr).toFixed(2))\n        : 0,\n\n      \"CPM\": campanha.cpm\n        ? Number(Number(campanha.cpm).toFixed(2))\n        : 0,\n\n      \"CPL\": cpl !== null\n        ? Number(cpl.toFixed(2))\n        : \"\",\n\n      \"CLIQUES LINK\": cliquesLink,\n      \"CONVERSAS INICIADAS\": conversasIniciadas,\n      \"PRIMEIRAS RESPOSTAS\": primeirasRespostas,\n      \"CONEXOES MENSAGEM\": conexoesMensagem,\n      \"VISUALIZAÇÕES VIDEO\": visualizacoesVideo,\n\n      \"CUSTO POR CONVERSA\": custoPorConversa !== null\n        ? Number(custoPorConversa.toFixed(2))\n        : \"\"\n    }\n  };\n});"
      },
