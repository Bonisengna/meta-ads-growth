APP_NAME=DescompliADS API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
TIMEZONE=America/Sao_Paulo

# Supabase — nunca versionar os valores reais.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_HEALTH_TABLE=app_health

# Meta Graph API — nunca versionar os valores reais.
META_GRAPH_BASE_URL=https://graph.facebook.com
META_GRAPH_VERSION=v25.0
META_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=
META_REQUEST_TIMEOUT_SECONDS=30
META_SYNC_LOOKBACK_DAYS=3
META_SYNC_MAX_ATTEMPTS=3
META_SYNC_RETRY_DELAY_SECONDS=2
META_SYNC_LOCK_MINUTES=120
META_SYNC_DAILY_TIME=03:00
META_SYNC_RUN_ON_START=false
META_HEALTH_STALE_HOURS=26

# Segurança HTTP
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
